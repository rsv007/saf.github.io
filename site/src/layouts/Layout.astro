---
import "../styles/global.css";
import { SITE } from "@/data/content";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import PawTrail from "@/components/PawTrail.astro";

interface Props { title?: string; description?: string; home?: boolean; noindex?: boolean; footerMascot?: boolean }
const { title, description = SITE.description, home = false, noindex = false, footerMascot = true } = Astro.props;
const fullName = `${SITE.name}, ${SITE.credential}`;
const pageTitle = title ? `${title} · ${fullName}` : `${fullName} — Laboratory Animal Veterinarian`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL("/og-image.png", SITE.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try { if (localStorage.getItem("theme") === "dark") document.documentElement.dataset.theme = "dark"; } catch (_) {}
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("motion-ok");
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#FAF7F2" />
    <meta name="author" content={fullName} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={fullName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${fullName} — laboratory animal veterinarian`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-surface focus:px-4 focus:py-2">Skip to content</a>
    <Nav home={home} />
    <main id="main"><slot /></main>
    <Footer mascot={footerMascot} />
    {home && <PawTrail />}
    <script>
      // Fade each section in once when it comes into view (skipped with "reduce motion").
      const root = document.documentElement;
      if (root.classList.contains("motion-ok") && "IntersectionObserver" in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
        }, { rootMargin: "0px 0px -8% 0px" });
        document.querySelectorAll(".reveal > *").forEach((el) => io.observe(el));
        root.classList.add("reveal-ready");
        // Heartbeat dividers only run while on screen
        const live = new IntersectionObserver((entries) => {
          for (const e of entries) e.target.classList.toggle("live", e.isIntersecting);
        });
        document.querySelectorAll(".ecg-divider").forEach((el) => live.observe(el));
      }
    </script>
  </body>
</html>
