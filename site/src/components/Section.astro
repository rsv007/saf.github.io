---
// Wrapper for each homepage section: anchor id, eyebrow label and heading.
const { id, eyebrow = "", title = "", intro = "", class: cls = "" } = Astro.props;
---
<section id={id} class:list={["reveal mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20", cls]} aria-labelledby={`${id}-title`}>
  <header class="mb-10 max-w-2xl">
    {eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
    <h2 id={`${id}-title`} class="text-3xl sm:text-4xl font-medium">{title}</h2>
    {intro && <p class="mt-3 text-muted">{intro}</p>}
  </header>
  <slot />
</section>
