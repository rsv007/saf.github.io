---
import { PHOTOS } from "@/data/content";
import PhotoSlot from "../PhotoSlot.astro";
---
{PHOTOS.length > 0 && (
  <section class="reveal mx-auto max-w-5xl px-4 py-8 sm:px-6" aria-label="Photos">
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
      {PHOTOS.map((p, i) => <PhotoSlot {...p} class={`aspect-[4/3] shadow-card ${i === 2 ? "col-span-2 md:col-span-1" : ""}`} />)}
    </div>
  </section>
)}
