---
import { ABOUT, SITE } from "@/data/content";
import Section from "../Section.astro";
import PhotoSlot from "../PhotoSlot.astro";
import MousePeek from "../mascots/MousePeek.astro";
import T from "../T.astro";
---
<Section id="about" eyebrow="About" title="About me">
  <div class="grid gap-10 md:grid-cols-[0.8fr_1.2fr] md:items-stretch">
    <!-- From md up the photo is exactly as tall as the bio text next to it (filled, edges trimmed) -->
    <div class="relative">
      <PhotoSlot {...SITE.aboutPhoto} class="aspect-[4/3] w-full shadow-card md:absolute md:inset-0 md:aspect-auto md:h-full" />
    </div>
    <div class="space-y-4 text-lg">
      {ABOUT.bio.map((p) => <p><T text={p} /></p>)}
    </div>
  </div>
  {ABOUT.values.length > 0 && (
    <div class="mt-12">
      <h3 class="mb-5 text-2xl font-medium">How I practice</h3>
      <ul class="grid gap-5 sm:grid-cols-3">
        {ABOUT.values.map((v, i) => (
          <li class="card lift relative p-6">
            {i === 0 && <div class="peek-wrap absolute bottom-full right-6 h-8 overflow-hidden" aria-hidden="true"><MousePeek class="peek block h-8 w-auto text-ink" /></div>}
            <h4 class="font-serif text-lg font-medium"><T text={v.title} /></h4>
            <p class="mt-2 text-muted"><T text={v.text} /></p>
          </li>
        ))}
      </ul>
    </div>
  )}
</Section>

<script>
  // Peeking mouse: slide up once when the card comes into view.
  const wrap = document.querySelector(".peek-wrap");
  if (wrap) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { wrap.classList.add("in"); io.disconnect(); }
    }, { rootMargin: "0px 0px -20% 0px" });
    io.observe(wrap.parentElement!);
  }
</script>
