---
import { EDUCATION, LICENSES, CERTIFICATIONS } from "@/data/content";
import Section from "../Section.astro";
import { GraduationCap, ShieldCheck, Award } from "@lucide/astro";
import T from "../T.astro";
---
<Section id="credentials" eyebrow="Credentials" title="Education, licensure & certifications">
  <div class="grid gap-5 lg:grid-cols-3">
    <div class="card p-6 lg:col-span-2">
      <h3 class="mb-4 flex items-center gap-2 font-serif text-xl font-medium"><GraduationCap class="size-6 text-sage-ink" stroke-width={1.75} aria-hidden="true" /> Education & training</h3>
      <ul class="divide-y divide-line">
        {EDUCATION.map((e) => (
          <li class="py-4 first:pt-0 last:pb-0">
            <p class="font-semibold">{e.degree}</p>
            <p class="text-muted">{e.school} · {e.dates}</p>
          </li>
        ))}
      </ul>
    </div>
    <div class="space-y-5">
      <div class="card p-6">
        <h3 class="mb-4 flex items-center gap-2 font-serif text-xl font-medium"><ShieldCheck class="size-6 text-sage-ink" stroke-width={1.75} aria-hidden="true" /> Licensure</h3>
        <ul class="space-y-3">
          {LICENSES.map((l) => (
            <li>
              <p class="font-semibold"><T text={l.name} /></p>
              {l.status && <span class="chip mt-1 text-sm"><T text={l.status} /></span>}
              {l.verifyLink && <a href={l.verifyLink} class="ml-2 text-sm underline underline-offset-2">Verify</a>}
            </li>
          ))}
        </ul>
      </div>
      {CERTIFICATIONS.length > 0 && (
        <div class="card p-6">
          <h3 class="mb-4 flex items-center gap-2 font-serif text-xl font-medium"><Award class="size-6 text-sage-ink" stroke-width={1.75} aria-hidden="true" /> Certifications & memberships</h3>
          <ul class="space-y-3">
            {CERTIFICATIONS.map((c) => (
              <li><p class="font-semibold">{c.name}</p>{c.status && <span class="chip mt-1 text-sm"><T text={c.status} /></span>}</li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</Section>
