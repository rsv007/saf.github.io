---
import { SITE, CONTACT } from "@/data/content";
import Section from "../Section.astro";
import LinkedInIcon from "../LinkedInIcon.astro";
import { Mail, Copy, Check } from "@lucide/astro";
import T from "../T.astro";
const linkedinReady = SITE.linkedin.startsWith("http");
---
<Section id="contact" eyebrow="Contact" title={CONTACT.heading}>
  <div class="max-w-xl">
    <div>
      {CONTACT.text && <p class="mb-6 text-lg"><T text={CONTACT.text} /></p>}
      <div class="flex flex-wrap items-center gap-3">
        <a href={`mailto:${SITE.email}`} class="btn btn-primary"><Mail class="size-4" stroke-width={2.25} aria-hidden="true" /> {SITE.email}</a>
        <button type="button" class="copy-email btn btn-secondary" data-email={SITE.email}>
          <Copy class="icon-copy size-4" stroke-width={2.25} aria-hidden="true" />
          <Check class="icon-done hidden size-4" stroke-width={2.25} aria-hidden="true" />
          <span class="label">Copy email</span>
        </button>
        {linkedinReady && <a href={SITE.linkedin} class="btn btn-secondary"><LinkedInIcon class="size-4 text-sage-ink" /> LinkedIn</a>}
      </div>
    </div>
  </div>
</Section>
<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-email").forEach((btn) => {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.email ?? "");
        btn.querySelector(".icon-copy")?.classList.add("hidden");
        btn.querySelector(".icon-done")?.classList.remove("hidden");
        btn.querySelector(".label")!.textContent = "Copied!";
        setTimeout(() => {
          btn.querySelector(".icon-copy")?.classList.remove("hidden");
          btn.querySelector(".icon-done")?.classList.add("hidden");
          btn.querySelector(".label")!.textContent = "Copy email";
        }, 2000);
      } catch {}
    });
  });
</script>
