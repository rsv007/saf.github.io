---
import { TESTIMONIALS } from "@/data/content";
import Section from "../Section.astro";
---
{TESTIMONIALS.length > 0 && (
  <Section id="testimonials" eyebrow="Kind words" title="What colleagues say">
    <ul class="grid gap-5 md:grid-cols-2">
      {TESTIMONIALS.map((t) => (
        <li class="card p-6">
          <blockquote class="font-serif text-lg leading-relaxed">“{t.quote}”</blockquote>
          <p class="mt-4 font-semibold">{t.name}</p>
          <p class="text-sm text-muted">{t.role}</p>
        </li>
      ))}
    </ul>
  </Section>
)}
