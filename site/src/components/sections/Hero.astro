---
import { SITE } from "@/data/content";
import { Download, Mail, MapPin } from "@lucide/astro";
import PhotoSlot from "../PhotoSlot.astro";
import HeroSignature from "../HeroSignature.astro";
import T from "../T.astro";
---
<section class="mx-auto grid max-w-5xl items-center gap-10 px-4 pt-10 pb-12 sm:px-6 md:grid-cols-[1.15fr_0.85fr] md:pt-20 md:pb-20">
  <div class="order-2 md:order-1">
    <p class="eyebrow mb-4"><T text={SITE.role} /></p>
    <h1 class="text-[2.6rem] leading-[1.05] font-medium sm:text-6xl">
      {SITE.name}, <span class="text-sage-ink">{SITE.credential}</span>
    </h1>
    <HeroSignature class="mt-4 mb-6 block h-auto w-full max-w-md" />
    <p class="max-w-xl text-lg text-ink sm:text-xl"><T text={SITE.tagline} /></p>
    {SITE.seeking && <p class="mt-3 max-w-xl text-muted"><T text={SITE.seeking} /></p>}
    <p class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-muted">
      <MapPin class="size-4 text-sage-ink" stroke-width={2} aria-hidden="true" />
      <span>{SITE.location}</span>{SITE.relocation && <><span aria-hidden="true">·</span><span><T text={SITE.relocation} /></span></>}
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={SITE.cvPdf} class="btn btn-primary" download><Download class="size-4" stroke-width={2.25} aria-hidden="true" /> Download CV</a>
      <a href="#contact" class="btn btn-secondary"><Mail class="size-4" stroke-width={2.25} aria-hidden="true" /> Contact me</a>
    </div>
  </div>
  <div class="order-1 md:order-2">
    <PhotoSlot {...SITE.heroPhoto} eager class="mx-auto aspect-[4/5] w-full max-w-[22rem] shadow-card md:max-w-none" />
  </div>
</section>
