---
import { EXPERIENCE, LEADERSHIP } from "@/data/content";
import Section from "../Section.astro";
import T from "../T.astro";
---
<Section id="experience" eyebrow="Experience" title="Clinical experience">
  <ol class="timeline relative ml-2 pl-7 sm:ml-3 sm:pl-10">
    {EXPERIENCE.map((job, i) => (
      <li class="relative pb-10 last:pb-0" style={`--i:${i}`}>
        <span class="dot absolute top-2 -left-[calc(1.75rem+7px)] size-3 rounded-full bg-sage ring-4 ring-bg sm:-left-[calc(2.5rem+7px)]" aria-hidden="true"></span>
        <p class="text-sm font-semibold text-sage-ink">{job.dates}</p>
        <h3 class="mt-1 text-xl font-medium sm:text-2xl">{job.role}</h3>
        <p class="text-muted">{job.org} · <T text={job.place} /></p>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 marker:text-sage">
          {job.points.map((pt) => <li><T text={pt} /></li>)}
        </ul>
      </li>
    ))}
  </ol>
  {LEADERSHIP.length > 0 && (
    <div class="mt-14">
      <h3 class="mb-5 text-2xl font-medium">Leadership & service</h3>
      <ul class="grid gap-4 sm:grid-cols-2">
        {LEADERSHIP.map((l) => (
          <li class="card lift p-5">
            <p class="text-sm font-semibold text-sage-ink">{l.dates}</p>
            <p class="mt-1 font-semibold">{l.role}</p>
            <p class="text-muted">{l.org}</p>
          </li>
        ))}
      </ul>
    </div>
  )}
</Section>
