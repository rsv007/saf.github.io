---
// Hero signature: the heartbeat line draws itself, and its last beat turns into the mouse.
// Without JavaScript or with "reduce motion" on, the finished drawing simply shows.
// The mouse part matches mascots/MouseFace.astro (same 64×64 drawing, scaled into place).
const { class: cls = "" } = Astro.props;
const BEAT = "M-10 40H14L20 26L26 52L32 40H40"; // last heartbeat, in mouse coordinates
---
<svg class:list={["hero-sig", cls]} viewBox="0 0 436 56" fill="none" aria-hidden="true" data-beat={BEAT}>
  <path class="sig-line" d="M0 34H96L104 34L111 22L118 34H140L147 41L156 8L165 44L172 34H230L237 34L244 25L251 34H372"
    stroke="var(--sage)" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" />
  <g transform="translate(380 2) scale(0.8)" stroke="var(--ink)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
    <g class="sig-ears">
      <circle cx="17" cy="21" r="10" fill="var(--surface)" />
      <circle cx="47" cy="21" r="10" fill="var(--surface)" />
      <circle cx="17" cy="21" r="5.5" fill="var(--coral-soft)" stroke="none" />
      <circle cx="47" cy="21" r="5.5" fill="var(--coral-soft)" stroke="none" />
    </g>
    <path class="sig-head" d="M32 19C42 19 48 26 48 34C48 42 40 50 32 52C24 50 16 42 16 34C16 26 22 19 32 19Z" fill="var(--surface)" />
    <g class="sig-face">
      <circle cx="25.5" cy="33" r="2.1" fill="var(--ink)" stroke="none" />
      <circle cx="38.5" cy="33" r="2.1" fill="var(--ink)" stroke="none" />
      <ellipse cx="22.5" cy="39.5" rx="2.6" ry="1.6" fill="var(--coral)" opacity=".35" stroke="none" />
      <ellipse cx="41.5" cy="39.5" rx="2.6" ry="1.6" fill="var(--coral)" opacity=".35" stroke="none" />
      <circle cx="32" cy="43" r="2.1" fill="var(--coral)" stroke="none" />
      <path d="M29.2 46.6q1.4 1.5 2.8 0q1.4 1.5 2.8 0" stroke-width="1.8" />
      <path d="M21 42.5L12 41M21 45.5L12.5 47M43 42.5L52 41M43 45.5L51.5 47" stroke-width="1.6" opacity=".55" />
    </g>
  </g>
</svg>

<style>
  /* Hidden only while the animation is about to play (class set in <head>);
     a safety timer reveals it after 3s even if the script never runs. */
  :global(html.motion-ok) .hero-sig {
    visibility: hidden;
    animation: sig-failsafe 0s 3s forwards;
  }
  :global(html.motion-ok) .hero-sig.is-ready { visibility: visible; animation: none; }
  @keyframes sig-failsafe { to { visibility: visible; } }
</style>

<script>
  import { gsap } from "gsap";
  import { DrawSVGPlugin } from "gsap/DrawSVGPlugin";
  import { MorphSVGPlugin } from "gsap/MorphSVGPlugin";

  const svg = document.querySelector<SVGSVGElement>(".hero-sig");
  if (svg && document.documentElement.classList.contains("motion-ok")) {
    gsap.registerPlugin(DrawSVGPlugin, MorphSVGPlugin);
    const head = svg.querySelector(".sig-head")!;
    const beat = svg.dataset.beat!;
    const headShape = head.getAttribute("d")!;
    const css = getComputedStyle(document.documentElement);
    const sage = css.getPropertyValue("--sage").trim();
    const ink = css.getPropertyValue("--ink").trim();

    gsap.set(svg.querySelector(".sig-line"), { drawSVG: "0%" });
    gsap.set(head, { morphSVG: beat, drawSVG: "0%", fillOpacity: 0, stroke: sage });
    gsap.set(svg.querySelector(".sig-ears"), { autoAlpha: 0, scale: 0.4, transformOrigin: "50% 100%" });
    gsap.set(svg.querySelector(".sig-face"), { autoAlpha: 0 });
    svg.classList.add("is-ready");

    const tl = gsap.timeline({ delay: 0.3, defaults: { ease: "power1.inOut" } })
      .to(svg.querySelector(".sig-line"), { drawSVG: "100%", duration: 1.1, ease: "none" })
      .to(head, { drawSVG: "100%", duration: 0.25, ease: "none" })
      .set(head, { clearProps: "strokeDasharray,strokeDashoffset" })
      .to(head, { morphSVG: { shape: headShape }, stroke: ink, duration: 0.55 }, "+=0.05")
      .to(head, { fillOpacity: 1, duration: 0.3 }, "-=0.2")
      .to(svg.querySelector(".sig-ears"), { autoAlpha: 1, scale: 1, duration: 0.35, ease: "back.out(2)" }, "-=0.25")
      .to(svg.querySelector(".sig-face"), { autoAlpha: 1, duration: 0.3 }, "-=0.1")
      .set(head, { clearProps: "stroke,fillOpacity" });
    // Safety net: if animation frames never run (e.g. a throttled tab), show the finished drawing.
    setTimeout(() => { if (tl.progress() === 0) tl.progress(1); }, 4000);
  }
</script>
