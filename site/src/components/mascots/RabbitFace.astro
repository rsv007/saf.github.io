---
// Rabbit mascot — face. Decorative only.
const { class: cls = "" } = Astro.props;
---
<svg class={cls} viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <ellipse cx="24" cy="17" rx="5.5" ry="13" transform="rotate(-12 24 17)" fill="var(--surface)" />
  <ellipse cx="40" cy="17" rx="5.5" ry="13" transform="rotate(12 40 17)" fill="var(--surface)" />
  <ellipse cx="24" cy="18" rx="2.4" ry="8.5" transform="rotate(-12 24 18)" fill="var(--coral-soft)" stroke="none" />
  <ellipse cx="40" cy="18" rx="2.4" ry="8.5" transform="rotate(12 40 18)" fill="var(--coral-soft)" stroke="none" />
  <ellipse cx="32" cy="40" rx="15.5" ry="13.5" fill="var(--surface)" />
  <circle cx="26" cy="38.5" r="2.1" fill="currentColor" stroke="none" />
  <circle cx="38" cy="38.5" r="2.1" fill="currentColor" stroke="none" />
  <ellipse cx="22.5" cy="44" rx="2.6" ry="1.6" fill="var(--coral)" opacity=".35" stroke="none" />
  <ellipse cx="41.5" cy="44" rx="2.6" ry="1.6" fill="var(--coral)" opacity=".35" stroke="none" />
  <path d="M30.2 42.8Q32 42 33.8 42.8Q32 45.4 30.2 42.8Z" fill="var(--coral)" stroke="var(--coral)" stroke-width="1.2" />
  <path d="M32 44.6v1.8M32 46.4q-1.6 1.6-3.3.4M32 46.4q1.6 1.6 3.3.4" stroke-width="1.6" />
</svg>
