---
import { SITE } from "@/data/content";
import RabbitSleeping from "./mascots/RabbitSleeping.astro";
const { mascot = true } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="mt-8 border-t border-line print:hidden">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-3 px-4 py-12 text-center sm:px-6">
    {mascot && <RabbitSleeping class="footer-rabbit h-14 w-auto text-ink" />}
    <p class="font-serif text-lg">Thanks for visiting.</p>
    <p class="text-sm text-muted">
      © {year} {SITE.name}, {SITE.credential} · Built with <a class="underline underline-offset-2 hover:text-ink" href="https://astro.build">Astro</a> ·
      Based on the <a class="underline underline-offset-2 hover:text-ink" href="https://github.com/webrating/starfolio">Starfolio</a> template (MIT)
    </p>
  </div>
</footer>

<script>
  // Desktop only: the sleeping rabbit opens its eyes and looks at the pointer when it's near.
  const rabbit = document.querySelector<SVGSVGElement>(".footer-rabbit");
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (rabbit && fine && !calm) {
    const open = rabbit.querySelector<SVGGElement>(".eyes-open")!;
    const closed = rabbit.querySelector<SVGPathElement>(".eyes-closed")!;
    const pupils = rabbit.querySelectorAll<SVGCircleElement>(".pupil");
    open.style.transition = closed.style.transition = "opacity .25s ease";
    let frame = 0;
    window.addEventListener("pointermove", (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const r = rabbit.getBoundingClientRect();
        const cx = r.left + r.width * 0.28, cy = r.top + r.height * 0.65;
        const dx = e.clientX - cx, dy = e.clientY - cy;
        const near = Math.hypot(dx, dy) < 220;
        open.style.opacity = near ? "1" : "0";
        closed.style.opacity = near ? "0" : "1";
        const len = Math.hypot(dx, dy) || 1;
        const k = 1.1; // how far the pupils move (in drawing units)
        pupils.forEach((p) => p.setAttribute("transform", `translate(${(dx / len) * k} ${(dy / len) * k})`));
      });
    }, { passive: true });
  }
</script>
