---
// Web version of the CV. Matches the downloadable PDF word for word: the text lives in src/data/cv.ts.
import Layout from "@/layouts/Layout.astro";
import { Download, Printer } from "@lucide/astro";
import { SITE } from "@/data/content";
import { CV_HEADER, CV_SECTIONS, CV_CERTIFICATIONS, type CvEntry } from "@/data/cv";

// Split `rest` around linkText so that part becomes a link.
function restParts(e: CvEntry) {
  if (!e.rest) return null;
  if (!e.link || !e.linkText || !e.rest.includes(e.linkText)) return { before: e.rest, link: "", after: "" };
  const i = e.rest.indexOf(e.linkText);
  return { before: e.rest.slice(0, i), link: e.linkText, after: e.rest.slice(i + e.linkText.length) };
}
---
<Layout title="CV" description={`CV of ${CV_HEADER.name}`}>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3 print:hidden">
      <p class="text-sm text-muted">Last updated {SITE.cvUpdated}</p>
      <div class="flex gap-2">
        <button type="button" onclick="window.print()" class="btn btn-secondary"><Printer class="size-4" stroke-width={2.25} aria-hidden="true" /> Print</button>
        <a href={SITE.cvPdf} download class="btn btn-primary"><Download class="size-4" stroke-width={2.25} aria-hidden="true" /> Download PDF</a>
      </div>
    </div>

    <article class="cv card p-6 sm:p-10">
      <header class="text-center">
        <h1 class="text-4xl font-medium">{CV_HEADER.name}</h1>
        <p class="mt-2 text-muted">{CV_HEADER.email}</p>
      </header>

      {CV_SECTIONS.map((s) => (
        <section>
          <h2>{s.heading}</h2>
          {s.entries.map((e) => {
            const r = restParts(e);
            return (
              <div class="entry">
                <div class="row">
                  <p class="first"><strong>{e.lead}</strong>{r && <>{r.before}{r.link && <a href={e.link}>{r.link}</a>}{r.after}</>}</p>
                  {e.date && <span class="date">{e.date}</span>}
                </div>
                {e.lines?.map((l) => <p>{l}</p>)}
                {e.bullets && <ul>{e.bullets.map((b) => <li>{b}</li>)}</ul>}
              </div>
            );
          })}
        </section>
      ))}

      <section>
        <h2>{CV_CERTIFICATIONS.heading}</h2>
        {CV_CERTIFICATIONS.items.map((c) => <p>{c.text}{c.em && <em>{c.em}</em>}</p>)}
      </section>
    </article>
  </div>
</Layout>

<style>
  .cv section { margin-top: 1.9rem; }
  .cv h2 {
    font-family: var(--heading-font, inherit);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.15rem;
    margin-bottom: 0.9rem;
  }
  .cv .entry { margin-bottom: 0.95rem; break-inside: avoid; }
  .cv .row { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .cv .row .first { flex: 1 1 auto; min-width: 0; }
  .cv .date { white-space: nowrap; flex: none; }
  .cv strong { font-weight: 650; }
  .cv a { text-decoration: underline; text-underline-offset: 2px; }
  .cv ul { list-style: disc; padding-left: 1.2rem; margin-top: 0.2rem; }
  .cv li { margin-top: 0.25rem; }

  @media print {
    @page { size: letter; margin: 0.6in; }
    :global(html) { font-size: 10.5pt; }
    :global(body) { background: #fff !important; color: #000 !important; }
    .cv { border: 0 !important; box-shadow: none !important; padding: 0 !important; background: #fff !important; }
    .cv h2 { color: #000; border-color: #000; }
    .cv a { color: inherit; text-decoration: none; }
  }
</style>
