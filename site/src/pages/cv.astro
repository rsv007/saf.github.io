---
// Printable web version of the CV. Built from the same content file as the homepage.
import Layout from "@/layouts/Layout.astro";
import T from "@/components/T.astro";
import { Download, Printer } from "@lucide/astro";
import { SITE, EXPERIENCE, LEADERSHIP, EDUCATION, RESEARCH, PUBLICATIONS, PRESENTATIONS, LICENSES, CERTIFICATIONS, SPECIES } from "@/data/content";
const linkedinReady = SITE.linkedin.startsWith("http");
---
<Layout title="CV" description={`CV of ${SITE.name}, ${SITE.credential}`}>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3 print:hidden">
      <p class="text-sm text-muted">Last updated {SITE.cvUpdated}</p>
      <div class="flex gap-2">
        <button type="button" onclick="window.print()" class="btn btn-secondary"><Printer class="size-4" stroke-width={2.25} aria-hidden="true" /> Print</button>
        <a href={SITE.cvPdf} download class="btn btn-primary"><Download class="size-4" stroke-width={2.25} aria-hidden="true" /> Download PDF</a>
      </div>
    </div>

    <article class="cv card p-6 sm:p-10">
      <header class="border-b border-line pb-5">
        <h1 class="text-4xl font-medium">{SITE.name}, {SITE.credential}</h1>
        <p class="mt-2 text-muted">
          <a href={`mailto:${SITE.email}`} class="underline underline-offset-2">{SITE.email}</a> · {SITE.location} ·
          {linkedinReady ? <a href={SITE.linkedin}>LinkedIn</a> : <T text={SITE.linkedin} />}
        </p>
      </header>

      <section>
        <h2>Summary</h2>
        <p><T text={SITE.tagline} /> Background in anesthesia, surgery, perioperative care, animal welfare, research collaboration and comparative medicine.</p>
      </section>

      <section>
        <h2>Education & postgraduate training</h2>
        {EDUCATION.map((e) => (
          <div class="entry"><div class="row"><strong>{e.school}</strong><span>{e.dates}</span></div><p>{e.degree}</p></div>
        ))}
      </section>

      <section>
        <h2>Clinical experience</h2>
        {EXPERIENCE.map((j) => (
          <div class="entry">
            <div class="row"><strong>{j.role}</strong><span>{j.dates}</span></div>
            <p class="sub">{j.org} · <T text={j.place} /></p>
            <ul>{j.points.map((p) => <li><T text={p} /></li>)}</ul>
          </div>
        ))}
      </section>

      <section>
        <h2>Species experience</h2>
        <p>{SPECIES.flatMap((s) => s.items).join(", ")}</p>
      </section>

      <section>
        <h2>Research experience</h2>
        {RESEARCH.map((r) => (
          <div class="entry"><div class="row"><strong>{r.title}</strong><span>{r.year}</span></div><p class="sub">{r.org}</p><p>{r.text}</p></div>
        ))}
      </section>

      {PUBLICATIONS.length > 0 && (
        <section>
          <h2>Publications & manuscripts</h2>
          {PUBLICATIONS.map((p) => (
            <div class="entry"><p><T text={p.authors} />. {p.title}. <em><T text={p.venue} /></em>{p.year && <>. <T text={p.year} /></>}.{p.link && <> <a href={p.link}>{p.link.replace("https://doi.org/", "doi:")}</a></>}</p></div>
          ))}
        </section>
      )}

      {PRESENTATIONS.length > 0 && (
        <section>
          <h2>Selected scientific presentations</h2>
          <ul>{PRESENTATIONS.map((p) => <li>{p.title} ({p.year})</li>)}</ul>
        </section>
      )}

      <section>
        <h2>Licensure & certifications</h2>
        <ul>
          {LICENSES.map((l) => <li><T text={l.name} />{l.status && <> — <T text={l.status} /></>}</li>)}
          {CERTIFICATIONS.map((c) => <li>{c.name}{c.status && <> — <T text={c.status} /></>}</li>)}
        </ul>
      </section>

      {LEADERSHIP.length > 0 && (
        <section>
          <h2>Additional experience & leadership</h2>
          {LEADERSHIP.map((l) => <div class="row entry"><span><strong>{l.role}</strong>, {l.org}</span><span>{l.dates}</span></div>)}
        </section>
      )}
    </article>
  </div>
</Layout>

<style>
  .cv section { margin-top: 1.75rem; }
  .cv h2 {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--sage-ink);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--body-font);
    margin-bottom: 0.6rem;
  }
  .cv .entry { margin-bottom: 0.9rem; break-inside: avoid; }
  .cv .row { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .cv .row > strong { flex: 1 1 0; min-width: 12rem; }
  .cv .row > span { color: var(--muted); white-space: nowrap; font-size: 0.95rem; }
  .cv .sub { color: var(--muted); }
  .cv ul { list-style: disc; padding-left: 1.2rem; }
  .cv li { margin-top: 0.2rem; }

  @media print {
    @page { size: letter; margin: 0.6in; }
    :global(html) { font-size: 10.5pt; }
    :global(body) { background: #fff !important; color: #000 !important; }
    .cv { border: 0 !important; box-shadow: none !important; padding: 0 !important; background: #fff !important; }
    .cv h2 { color: #1f3a44; }
    .cv a { color: inherit; text-decoration: none; }
    :global(mark.ask) { background: none; border: 0; }
  }
</style>
