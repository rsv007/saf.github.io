---
// TEMPORARY preview page for approving the mascot drawings. Delete before launch.
import Layout from "@/layouts/Layout.astro";
import MouseFace from "@/components/mascots/MouseFace.astro";
import RabbitFace from "@/components/mascots/RabbitFace.astro";
import MousePeek from "@/components/mascots/MousePeek.astro";
import RabbitSleeping from "@/components/mascots/RabbitSleeping.astro";
import RabbitHop from "@/components/mascots/RabbitHop.astro";
const items = [
  [MouseFace, "Mouse — hero (end of the heartbeat line) & skills icon", "h-28"],
  [RabbitFace, "Rabbit — face / icon", "h-28"],
  [MousePeek, "Mouse peeking over a card edge (About)", "h-20"],
  [RabbitSleeping, "Rabbit asleep (footer)", "h-24"],
  [RabbitHop, "Rabbit hopping away (404 page)", "h-24"],
];
---
<Layout title="Mascot preview" noindex>
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <h1 class="text-4xl font-medium">Mascot drawings — for approval</h1>
    <p class="mt-2 text-muted">Shown large here; on the site they're small (about the size of an icon).</p>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {items.map(([C, label, h]) => (
        <figure class="card flex flex-col items-center gap-4 p-6">
          <div class="flex h-32 items-end"><C class={`${h} w-auto text-ink`} /></div>
          <figcaption class="text-center text-sm text-muted">{label}</figcaption>
        </figure>
      ))}
      <figure class="card flex flex-col items-center gap-4 p-6">
        <div class="flex h-32 items-center gap-3"><MouseFace class="size-8 text-ink" /><RabbitFace class="size-8 text-ink" /><MouseFace class="size-5 text-ink" /><RabbitFace class="size-5 text-ink" /></div>
        <figcaption class="text-center text-sm text-muted">Actual small sizes (32px and 20px)</figcaption>
      </figure>
    </div>
  </section>
</Layout>
