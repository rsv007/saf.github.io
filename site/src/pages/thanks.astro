---
import Layout from "@/layouts/Layout.astro";
---
<Layout title="Message sent" noindex>
  <section class="mx-auto flex min-h-[50vh] max-w-xl flex-col items-center justify-center px-4 py-20 text-center">
    <h1 class="text-4xl font-medium">Thank you!</h1>
    <p class="mt-3 text-muted">Your message has been sent. I'll get back to you soon.</p>
    <a href="/" class="btn btn-secondary mt-8">Back to the main page</a>
  </section>
</Layout>
